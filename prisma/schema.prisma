datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SHOP_OWNER
  WAREHOUSE_STAFF
  ADMIN
}

enum MovementType {
  INFLOW
  OUTFLOW
  AUDIT_ADJUSTMENT
  ORDER_FULFILL
  ORDER_CANCEL_RESTOCK
  RETURN_RESTOCK
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  FULFILLED
  CANCELED
}

enum ReturnStatus {
  COMPLETED
}

enum AlertType {
  LOW_STOCK
  STOCKOUT
  OVERSTOCK_DEADSTOCK
  UNUSUAL_DEMAND
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum PricingAction {
  INCREASE
  DECREASE
  MAINTAIN
}

enum ImportJobStatus {
  PREVIEWED
  COMMITTING
  COMPLETED
  FAILED
  EXPIRED
}

enum ImportJobItemStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  SKIPPED
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum RecommendationStatus {
  PENDING
  ACCEPTED
  REJECTED
  MODIFIED
  EXPIRED
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model Store {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(255)
  code        String    @unique @db.VarChar(50)
  phone       String?   @db.VarChar(50)
  address     String?   @db.VarChar(255)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users                  User[]
  warehouses             Warehouse[]
  categories             Category[]
  products               Product[]
  stockItems             StockItem[]
  inventoryBalances      InventoryBalance[]
  stockMovements         StockMovement[]
  orders                 Order[]
  orderItems             OrderItem[]
  returnOrders           ReturnOrder[]
  returnItems            ReturnItem[]
  importJobs             ImportJob[]
  historicalSales        HistoricalSale[]
  dailySalesSummaries    DailySalesSummary[]
  engineConfig           EngineConfig?
  alerts                 Alert[]
  pricingRecommendations PricingRecommendation[]
  priceHistories         PriceHistory[]
  decisionSnapshots      DecisionSnapshot[]

  @@map("stores")
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique @db.VarChar(255)
  passwordHash String    @db.VarChar(255)
  fullName     String    @db.VarChar(255)
  role         Role      @default(SHOP_OWNER)
  isActive     Boolean   @default(true)
  storeId      Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  store                  Store?                  @relation(fields: [storeId], references: [id], onDelete: SetNull)
  sessions               AuthSession[]
  stockMovements         StockMovement[]
  ordersCreated          Order[]
  returnsCreated         ReturnOrder[]
  importJobsCreated      ImportJob[]
  pricingDecided         PricingRecommendation[]
  priceHistories         PriceHistory[]

  @@index([storeId])
  @@map("users")
}

model AuthSession {
  id               Int       @id @default(autoincrement())
  userId           Int
  refreshTokenHash String    @db.VarChar(255)
  expiresAt        DateTime
  revokedAt        DateTime?
  userAgent        String?   @db.VarChar(255)
  ipAddress        String?   @db.VarChar(50)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([refreshTokenHash])
  @@map("auth_sessions")
}

model Warehouse {
  id        Int       @id @default(autoincrement())
  storeId   Int
  name      String    @db.VarChar(255)
  location  String?   @db.VarChar(255)
  isDefault Boolean   @default(false)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  balances  InventoryBalance[]
  movements StockMovement[]

  @@index([storeId])
  @@map("warehouses")
}

model Category {
  id          Int       @id @default(autoincrement())
  storeId     Int
  name        String    @db.VarChar(255)
  code        String    @db.VarChar(50)
  description String?   @db.Text
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([storeId, code])
  @@index([storeId])
  @@map("categories")
}

model Product {
  id          Int       @id @default(autoincrement())
  storeId     Int
  categoryId  Int?
  name        String    @db.VarChar(255)
  code        String    @db.VarChar(50)
  description String?   @db.Text
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  store       Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category    Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  stockItems  StockItem[]

  @@unique([storeId, code])
  @@index([storeId])
  @@index([categoryId])
  @@map("products")
}

model StockItem {
  id            Int       @id @default(autoincrement())
  storeId       Int
  productId     Int
  sku           String    @db.VarChar(100)
  name          String    @db.VarChar(255)
  barcode       String?   @db.VarChar(100)
  costPrice     Decimal   @default(0.00) @db.Decimal(15, 2)
  sellingPrice  Decimal   @default(0.00) @db.Decimal(15, 2)
  minStockLevel Int       @default(0)
  maxStockLevel Int       @default(1000)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  store                  Store                    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product                Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  balances               InventoryBalance[]
  movements              StockMovement[]
  orderItems             OrderItem[]
  returnItems            ReturnItem[]
  historicalSales        HistoricalSale[]
  dailySalesSummaries    DailySalesSummary[]
  alerts                 Alert[]
  pricingRecommendations PricingRecommendation[]
  priceHistories         PriceHistory[]
  decisionSnapshots      DecisionSnapshot[]

  @@unique([storeId, sku])
  @@index([storeId])
  @@index([productId])
  @@map("stock_items")
}

model InventoryBalance {
  id               Int       @id @default(autoincrement())
  storeId          Int
  warehouseId      Int
  stockItemId      Int
  quantity         Int       @default(0)
  reservedQuantity Int       @default(0)
  updatedAt        DateTime  @updatedAt

  store            Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  stockItem        StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, stockItemId])
  @@index([storeId, stockItemId])
  @@map("inventory_balances")
}

model StockMovement {
  id             Int          @id @default(autoincrement())
  storeId        Int
  warehouseId    Int
  stockItemId    Int
  type           MovementType
  delta          Int
  beforeQuantity Int
  afterQuantity  Int
  referenceType  String       @db.VarChar(50)
  referenceId    String       @db.VarChar(100)
  idempotencyKey String?      @unique @db.VarChar(150)
  note           String?      @db.Text
  createdById    Int?
  createdAt      DateTime     @default(now())

  store          Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  warehouse      Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  stockItem      StockItem    @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  createdBy      User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([storeId, stockItemId, createdAt])
  @@index([warehouseId])
  @@map("stock_movements")
}

model Order {
  id              Int         @id @default(autoincrement())
  storeId         Int
  orderNumber     String      @db.VarChar(100)
  status          OrderStatus @default(DRAFT)
  customerName    String?     @db.VarChar(255)
  customerPhone   String?     @db.VarChar(50)
  customerAddress String?     @db.VarChar(255)
  subtotalAmount  Decimal     @default(0.00) @db.Decimal(15, 2)
  discountAmount  Decimal     @default(0.00) @db.Decimal(15, 2)
  taxAmount       Decimal     @default(0.00) @db.Decimal(15, 2)
  totalAmount     Decimal     @default(0.00) @db.Decimal(15, 2)
  note            String?     @db.Text
  confirmedAt     DateTime?
  fulfilledAt     DateTime?
  canceledAt      DateTime?
  cancelReason    String?     @db.Text
  createdById     Int?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  store           Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdBy       User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items           OrderItem[]
  returns         ReturnOrder[]

  @@unique([storeId, orderNumber])
  @@index([storeId, status, createdAt])
  @@map("orders")
}

model OrderItem {
  id                 Int         @id @default(autoincrement())
  storeId            Int
  orderId            Int
  stockItemId        Int
  skuSnapshot        String      @db.VarChar(100)
  nameSnapshot       String      @db.VarChar(255)
  unitPriceSnapshot  Decimal     @db.Decimal(15, 2)
  costPriceSnapshot  Decimal     @default(0.00) @db.Decimal(15, 2)
  quantity           Int
  refundableAmount   Decimal     @default(0.00) @db.Decimal(15, 2)
  refundedAmount     Decimal     @default(0.00) @db.Decimal(15, 2)
  returnedQuantity   Int         @default(0)
  subtotal           Decimal     @db.Decimal(15, 2)
  createdAt          DateTime    @default(now())

  store              Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order              Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stockItem          StockItem   @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  returnItems        ReturnItem[]

  @@index([storeId, orderId])
  @@index([stockItemId])
  @@map("order_items")
}

model ReturnOrder {
  id                Int          @id @default(autoincrement())
  storeId           Int
  orderId           Int
  returnNumber      String       @db.VarChar(100)
  status            ReturnStatus @default(COMPLETED)
  totalRefundAmount Decimal      @default(0.00) @db.Decimal(15, 2)
  reason            String?      @db.Text
  createdById       Int?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  store             Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order             Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy         User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items             ReturnItem[]

  @@unique([storeId, returnNumber])
  @@index([storeId, orderId])
  @@map("return_orders")
}

model ReturnItem {
  id                 Int         @id @default(autoincrement())
  storeId            Int
  returnOrderId      Int
  orderItemId        Int
  stockItemId        Int
  quantity           Int
  refundPrice        Decimal     @db.Decimal(15, 2)
  isRestockable      Boolean     @default(true)
  restockWarehouseId Int?
  note               String?     @db.Text
  createdAt          DateTime    @default(now())

  store              Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  returnOrder        ReturnOrder @relation(fields: [returnOrderId], references: [id], onDelete: Cascade)
  orderItem          OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  stockItem          StockItem   @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@index([storeId, returnOrderId])
  @@index([orderItemId])
  @@map("return_items")
}

model ImportJob {
  id          String          @id @default(uuid())
  storeId     Int
  createdById Int?
  type        String          @db.VarChar(50)
  payloadHash String          @db.VarChar(64)
  payloadJson Json
  status      ImportJobStatus @default(PREVIEWED)
  totalRows   Int             @default(0)
  validRows   Int             @default(0)
  invalidRows Int             @default(0)
  warningRows Int             @default(0)
  resultJson  Json?
  expiresAt   DateTime
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  store       Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdBy   User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items       ImportJobItem[]

  @@index([storeId, createdAt])
  @@index([storeId, payloadHash])
  @@map("import_jobs")
}

model ImportJobItem {
  id          Int                 @id @default(autoincrement())
  importJobId String
  rowNumber   Int
  stockItemId Int?
  sku         String              @db.VarChar(100)
  status      ImportJobItemStatus @default(PENDING)
  resultJson  Json?
  errorJson   Json?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  importJob   ImportJob           @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@unique([importJobId, rowNumber])
  @@index([importJobId, status])
  @@map("import_job_items")
}

model IdempotencyRequest {
  id           String            @id @default(uuid())
  storeId      Int
  operation    String            @db.VarChar(100)
  key          String            @db.VarChar(150)
  requestHash  String            @db.VarChar(64)
  status       IdempotencyStatus
  statusCode   Int?
  responseJson Json?
  expiresAt    DateTime
  createdAt    DateTime          @default(now())

  @@unique([storeId, operation, key])
  @@index([storeId, expiresAt])
  @@map("idempotency_requests")
}

model HistoricalSale {
  id              Int        @id @default(autoincrement())
  storeId         Int
  stockItemId     Int?
  externalSku     String     @db.VarChar(100)
  quantity        Int
  unitPrice       Decimal    @db.Decimal(15, 2)
  totalAmount     Decimal    @db.Decimal(15, 2)
  soldAt          DateTime
  source          String     @db.VarChar(50)
  externalOrderId String?    @db.VarChar(100)
  sourceRowHash   String     @db.VarChar(64)
  createdAt       DateTime   @default(now())

  store           Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  stockItem       StockItem? @relation(fields: [stockItemId], references: [id], onDelete: SetNull)

  @@unique([storeId, sourceRowHash])
  @@index([storeId, soldAt])
  @@index([storeId, stockItemId, soldAt])
  @@map("historical_sales")
}

model DailySalesSummary {
  id           Int       @id @default(autoincrement())
  storeId      Int
  stockItemId  Int
  summaryDate  DateTime  @db.Date

  grossSoldQty Int       @default(0)
  returnQty    Int       @default(0)
  netSoldQty   Int       @default(0)

  grossRevenue Decimal   @default(0.00) @db.Decimal(15, 2)
  refundAmount Decimal   @default(0.00) @db.Decimal(15, 2)
  netRevenue   Decimal   @default(0.00) @db.Decimal(15, 2)

  cogs         Decimal   @default(0.00) @db.Decimal(15, 2)
  grossProfit  Decimal   @default(0.00) @db.Decimal(15, 2)

  orderCount   Int       @default(0)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  stockItem    StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@unique([storeId, stockItemId, summaryDate])
  @@index([storeId, summaryDate])
  @@index([storeId, stockItemId, summaryDate])
  @@map("daily_sales_summaries")
}

model EngineConfig {
  id                    Int      @id @default(autoincrement())
  storeId               Int      @unique

  leadTimeDays          Int      @default(7)
  safetyDays            Int      @default(3)
  serviceLevel          Decimal  @default(0.95) @db.Decimal(5, 4)

  targetCoverageDays    Int      @default(30)
  slowMovingDays        Int      @default(60)
  deadStockDays         Int      @default(90)

  minimumHistoryDays    Int      @default(14)

  minimumMarginPct      Decimal  @default(0.20) @db.Decimal(6, 4)
  maxMarkdownPct        Decimal  @default(0.30) @db.Decimal(6, 4)
  maxMarkupPct          Decimal  @default(0.20) @db.Decimal(6, 4)

  lowRiskThreshold      Int      @default(25)
  highRiskThreshold     Int      @default(50)
  criticalRiskThreshold Int      @default(75)

  engineVersion         String   @default("DECISION_ENGINE_V1") @db.VarChar(50)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  store                 Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("engine_configs")
}

model Alert {
  id            Int           @id @default(autoincrement())
  storeId       Int
  stockItemId   Int
  type          AlertType
  severity      AlertSeverity
  status        AlertStatus   @default(OPEN)

  riskScore     Decimal?      @db.Decimal(5, 2)
  confidence    Decimal?      @default(100.00) @db.Decimal(5, 2)
  title         String        @db.VarChar(255)
  message       String        @db.Text
  reasonJson    Json
  fingerprint   String        @db.VarChar(64)
  engineVersion String        @default("DECISION_ENGINE_V1") @db.VarChar(50)

  openedAt      DateTime      @default(now())
  resolvedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  store         Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  stockItem     StockItem     @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@unique([storeId, fingerprint])
  @@index([storeId, status, severity])
  @@index([storeId, stockItemId])
  @@map("alerts")
}

model PricingRecommendation {
  id                     Int                  @id @default(autoincrement())
  storeId                Int
  stockItemId            Int

  currentPrice           Decimal              @db.Decimal(15, 2)
  recommendedPrice       Decimal              @db.Decimal(15, 2)
  discountPct            Decimal              @db.Decimal(5, 2)
  action                 PricingAction        @default(MAINTAIN)

  riskScore              Decimal?             @db.Decimal(5, 2)
  confidence             Decimal?             @default(100.00) @db.Decimal(5, 2)
  reasonJson             Json
  status                 RecommendationStatus @default(PENDING)
  engineVersion          String               @default("DECISION_ENGINE_V1") @db.VarChar(50)

  finalUserSelectedPrice Decimal?             @db.Decimal(15, 2)
  decidedById            Int?
  decidedAt              DateTime?
  expiresAt              DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  store                  Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  stockItem              StockItem            @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  decidedBy              User?                @relation(fields: [decidedById], references: [id], onDelete: SetNull)
  priceHistories         PriceHistory[]

  @@index([storeId, status])
  @@index([storeId, stockItemId])
  @@map("pricing_recommendations")
}

model PriceHistory {
  id               Int                    @id @default(autoincrement())
  storeId          Int
  stockItemId      Int
  oldPrice         Decimal                @db.Decimal(15, 2)
  newPrice         Decimal                @db.Decimal(15, 2)
  source           String                 @db.VarChar(50)
  recommendationId Int?
  reason           String?                @db.Text
  changedById      Int?
  changedAt        DateTime               @default(now())

  store            Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  stockItem        StockItem              @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  changedBy        User?                  @relation(fields: [changedById], references: [id], onDelete: SetNull)
  recommendation   PricingRecommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)

  @@index([storeId, stockItemId, changedAt])
  @@map("price_histories")
}

model DecisionSnapshot {
  id          Int       @id @default(autoincrement())
  storeId     Int
  stockItemId Int

  calculatedAt DateTime @default(now())
  inputJson    Json
  metricsJson  Json
  risksJson    Json
  version      String   @default("DECISION_ENGINE_V1") @db.VarChar(50)
  createdAt    DateTime @default(now())

  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  stockItem    StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@index([storeId, stockItemId, calculatedAt])
  @@map("decision_snapshots")
}
