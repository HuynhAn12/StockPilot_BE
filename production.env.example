# Mẫu backend/.env cho VPS production (docker-compose.yml + deploy.sh).
# Chép thành backend/.env trên VPS rồi điền giá trị thật. KHÔNG commit file .env.
#
# Tạo chuỗi ngẫu nhiên trên VPS:
#   openssl rand -hex 32   → JWT_SECRET, JWT_REFRESH_SECRET, PAYMENT_CONFIG_ENCRYPTION_KEY (64 ký tự hex)
#   openssl rand -hex 16   → MYSQL_ROOT_PASSWORD, MYSQL_PASSWORD (chỉ chữ + số, không cần mã hóa URL)

# ── Cơ sở dữ liệu (docker-compose dùng các biến này để tạo MySQL và DATABASE_URL) ──
# Lưu ý: MySQL chỉ đặt mật khẩu ở LẦN CHẠY ĐẦU (volume trống). Nếu VPS đã có dữ liệu,
# điền đúng mật khẩu đang dùng, hoặc đổi mật khẩu trong MySQL trước.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=stockpilot
MYSQL_USER=stockpilot_user
MYSQL_PASSWORD=

# ── Bảo mật (bắt buộc ở production, backend từ chối khởi động nếu thiếu/yếu) ──
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
# Khóa mã hóa cấu hình thanh toán (PayOS) của các cửa hàng. Đổi khóa = cấu hình đã lưu
# không giải mã được nữa: nếu DB đã có cấu hình PayOS, giữ nguyên khóa đang dùng.
PAYMENT_CONFIG_ENCRYPTION_KEY=

# ── Tên miền ──
TENANT_ROOT_DOMAIN=taphoasandg.com
CORS_ORIGIN=https://taphoasandg.com,https://*.taphoasandg.com,https://stockpilot.name.vn,https://*.stockpilot.name.vn
# false: vẫn đăng nhập được từ tên miền gốc; true: bắt buộc vào qua subdomain cửa hàng.
TENANT_SUBDOMAIN_REQUIRED=false
# Cloudflare → Nginx máy chủ → Nginx container frontend → backend.
TRUST_PROXY=3
APP_TIMEZONE=Asia/Ho_Chi_Minh
LOG_LEVEL=info

# ── Thanh toán PayOS (trang kết quả sau khi khách thanh toán) ──
PAYOS_RETURN_URL=https://taphoasandg.com/pos/success
PAYOS_CANCEL_URL=https://taphoasandg.com/pos/cancel

# ── Gửi email OTP (Gmail: dùng "mật khẩu ứng dụng", không dùng mật khẩu đăng nhập) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ── Trợ lý AI (tùy chọn; thiếu khóa thì trợ lý trả lời bằng luật) ──
AI_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
GROQ_API_KEY=
