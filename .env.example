NODE_ENV=development
PORT=5000
DATABASE_URL="mysql://<user>:<password>@<host>:3306/stockpilot"
JWT_SECRET="<replace-with-long-random-secret>"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="<replace-with-different-long-random-secret>"
JWT_REFRESH_EXPIRES_IN="7d"
TEST_DATABASE_URL="mysql://<user>:<password>@<host>:3306/stockpilot_test"
CORS_ORIGIN="http://localhost:3000"
TENANT_ROOT_DOMAIN="stockpilot.vn"
PAYMENT_CONFIG_ENCRYPTION_KEY="<32-byte-base64-or-64-character-hex-key>"
APP_TIMEZONE=Asia/Ho_Chi_Minh
LOG_LEVEL=info
TRUST_PROXY=false
DATABASE_POOL_SIZE=10
GENERAL_RATE_LIMIT_WINDOW_MS=900000
GENERAL_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
REQUEST_TIMEOUT_MS=30000
KEEP_ALIVE_TIMEOUT_MS=65000
HEADERS_TIMEOUT_MS=66000
SHUTDOWN_TIMEOUT_MS=10000

# Decision Engine triggers
# Nightly reconciliation job; defaults to enabled only when NODE_ENV=production.
DECISION_SCHEDULER_ENABLED=
# Local hour (APP_TIMEZONE) at which the nightly job runs.
DECISION_NIGHTLY_HOUR=1
# Coalescing delay for post-commit recomputation after sales, inventory, returns, and price changes.
DECISION_RECOMPUTE_DEBOUNCE_MS=500
# Maximum SKUs processed per POST /decision-engine/recalculate call (use nextCursor for the rest).
DECISION_RECALCULATE_MAX_SKUS=500

# AI Decision Assistant. Without a key for the chosen provider, the rule-based assistant answers instead.
# AI_PROVIDER: openai (Responses API), gemini or nvidia (both via OpenAI-compatible Chat Completions).
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Free key from Google AI Studio (https://aistudio.google.com). Free-tier requests may be used by Google to improve its products.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Key from https://build.nvidia.com (nvapi-...). Copy NVIDIA_MODEL from the model page's code sample.
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Per-request timeout; on timeout or error the rule-based answer is returned instead.
AI_TIMEOUT_MS=15000
# Set to false to disable AI calls even when a key is present.
AI_ENABLED=

# Gmail / SMTP Settings (Gửi mã OTP qua Gmail - điền tài khoản và mật khẩu ứng dụng Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="StockPilot Vietnam <no-reply@stockpilot.vn>"

# Public URL of the web app, used for links in admin alert emails
APP_PUBLIC_URL="http://localhost:5173"
